[Unit]
Description=InkyCal - Physical button handler (view toggle, force refresh, force update)
# Only the filesystem and GPIO are needed, and both are up long before
# multi-user.target is reached; ordering after that target just held the
# buttons back until everything else at boot had started. A press is the one
# control someone has when the display comes up wrong, so it should be live
# early.
After=local-fs.target

[Service]
Type=simple
ExecStart=/opt/inkycal/venv/bin/python -m inkycal.buttons
Restart=on-failure
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
