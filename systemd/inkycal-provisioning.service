[Unit]
Description=InkyCal setup mode (button C): WiFi over Bluetooth + Google token over WiFi
After=network.target bluetooth.target
Wants=network.target

# Not a long-running service. Started at boot, it exits straight away unless
# the device still has no Google token or WiFi network; button C starts it on
# demand. While it runs, the panel shows a one-time setup code that every
# change over Bluetooth or the network has to carry, and it stops listening
# after 10 minutes, or as soon as the Google token arrives.

[Service]
Type=simple
EnvironmentFile=-/opt/inkycal/.env
ExecStart=/opt/inkycal/venv/bin/python -m inkycal.provisioning
Restart=on-failure
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
