timezone: "America/Phoenix"

poll_interval_minutes: 15

sleep:
  enabled: true
  start: "21:45"   # 9:45 PM
  end: "05:00"     # 5:00 AM
  banner_text: "Sleeping — updates resume in the morning"

deep_clean:
  enabled: true
  weekday: "Sunday"
  time: "03:30"

display:
  # Inky Impressions 13.3 is usually 1600x1200 landscape.
  # We'll render portrait by swapping and rotating.
  width: 1200
  height: 1600
  rotate_degrees: 90   # 0/90/180/270 depending on how you mount it
  saturation: 0.0      # optional; depends on Inky driver support
  border: "white"

calendars:
  google:
    enabled: true
    calendar_ids:
      - "primary"
    # Google Tasks are rendered as the "Reminders" region (incomplete tasks due
    # today or overdue). Requires the tasks.readonly OAuth scope — re-run the
    # Google sign-in flow if your existing token predates this.
    tasks_enabled: true
    task_list_allowlist: []  # empty means all task lists
    # Birthdays (and anniversaries) that Google derives from your Google
    # Contacts live in their own read-only calendar. Leave this on to show
    # them alongside your other events — no extra OAuth scope is needed, and
    # the calendar is simply skipped if the account doesn't have one.
    birthdays_enabled: true
  icloud:
    enabled: true
    calendar_name_allowlist: []  # empty means all discovered calendars

travel:
  enabled: false
  origin_address: "123 Main St, Springfield, IL"
  back_to_back_window_minutes: 30

weather:
  latitude: 33.4353   # Goodyear, AZ (default)
  longitude: -112.3582

# Over-the-air updates. When enabled, the display checks GitHub on every refresh
# and shows "Update pending" in the bottom status bar (by the WiFi icon) when
# this checkout is behind the tracked branch. The inkycal-update systemd timer
# then pulls and applies the update — by default only during the overnight sleep
# window, so it never disrupts daytime viewing. Set enabled: false to freeze the
# installed version, or apply_window: anytime to apply updates as soon as found.
auto_update:
  enabled: true
  branch: "main"
  apply_window: "sleep"   # "sleep" = only overnight; "anytime" = as soon as found

# The Inky Impression's 4 built-in buttons (labeled A/B/C/D on the board):
#   A (pin_view)    - toggle between the daily view and a weekly view
#                     (next 7 days, event names only, no times)
#   B (pin_refresh) - force an immediate display refresh
#   C (pin_unused)  - unused / reserved for future use
#   D (pin_update)  - force an OTA update check, and apply it right away
#                     if one is pending (bypasses apply_window)
# Pin numbers are BCM GPIO numbers. The defaults below match the 13.3"
# Inky Impression; button C is wired to GPIO25 on that model instead of
# the GPIO16 used on the smaller 4"/5.7"/7.3" sizes.
# A press has to fetch calendars, weather and travel times before it can draw
# anything, so the panel would otherwise sit still for 10-60 seconds with no
# sign the press registered. press_feedback puts a short notice up first:
#   banner - keep the current schedule on screen, notice bar across the top
#   wipe   - clear the panel to a centred "Refreshing..." message
#   none   - no acknowledgement; the display stays put until content is ready
# The Impression has no partial refresh, so banner/wipe cost one extra
# full-panel repaint: content lands roughly twice as slowly, but you can see
# the press landed. Button C (unused) never shows one -- no work follows it.
buttons:
  enabled: true
  pin_view: 5
  pin_refresh: 6
  pin_unused: 25
  pin_update: 24
  bounce_time_ms: 300   # debounce window for the physical tactile buttons
  press_feedback: "banner"
  # Echo every press to the terminals of anyone logged in over SSH (and to
  # the local console), so you can see which button was pressed without
  # tailing the journal. Set to false to keep presses in the journal only.
  echo_to_terminals: true
